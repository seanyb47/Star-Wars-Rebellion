  "designRules": {
    "Early-game power": "Starting/early ships should not have multiple top-tier capabilities without major drawbacks.",
    "Build-time scale": "Aim for ~40 days at extreme low end and 1,000 days for Majestic.",
    "Crown starts": "Wayfinder, Interceptor I, Dreadnought, Sovereign. Vanguard is R1.",
    "Confederacy starts": "Swift, Brigantine, Freebooter, Cutlass. Marauder is R1.",
    "Starting Confederacy asymmetry": "Swift explores; Brigantine handles utility/logistics; Freebooter boards/carries troops; Cutlass is the conventional combatant.",
    "Weapon system": "Long Guns, Heavy Guns, Light Guns only.",
    "Long Guns": "Midgame technology milestone; First Strike and pursuit role.",
    "Bombardment": "Only affects fortifications/locations, never ship-to-ship combat.",
    "Endgame": "Majestic is the strongest individual ship; Reef-Class + Urskin Whaler should exceed it as a combined Confederacy fleet.",
    "Ship identity": "Not every ship needs to be good; specialized or temporarily suboptimal ships are intentional."
  },
