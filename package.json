{
  "name": "master-of-the-seven-seas",
  "private": true,
  "version": "0.11.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "art": "python3 scripts/art.py",
    "art:add": "python3 scripts/art.py add",
    "voices": "python3 scripts/render_voicelines.py",
    "narrator:web": "python3 scripts/narrator_web_stills.py",
    "narrator:check": "python3 scripts/check_narrator_assets.py",
    "art:recrop": "python3 scripts/art.py recrop",
    "art:list": "python3 scripts/art.py list",
    "art:check": "python3 scripts/art.py check",
    "art:doc": "python3 scripts/art.py doc"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
